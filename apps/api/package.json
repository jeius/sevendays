{
  "name": "@sevendays/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --project tsconfig.build.json",
    "deploy": "wrangler deploy",
    "lint": "biome lint",
    "format": "biome format",
    "fix": "biome check --fix .",
    "fix:unsafe": "biome check --fix --unsafe .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@sevendays/db": "workspace:*",
    "@sevendays/types": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^4.5.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@sevendays/config": "workspace:*",
    "postgres": "^3.4.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}

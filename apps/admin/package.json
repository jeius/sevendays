{
  "name": "@sevendays/admin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "vite build && cp instrument.server.mjs dist/server",
    "preview": "vite preview",
    "start": "node --import ./dist/server/instrument.server.mjs dist/server/index.js",
    "lint": "biome lint",
    "format": "biome format",
    "fix": "biome check --fix .",
    "fix:unsafe": "biome check --fix --unsafe .",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@posthog/react": "^1.10.5",
    "@sentry/tanstackstart-react": "^10.72.0",
    "@sevendays/types": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.37.0",
    "posthog-js": "^1.422.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@sevendays/config": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}

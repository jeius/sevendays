{
  "name": "@sevendays/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "biome lint",
    "format": "biome format",
    "fix": "biome check --fix .",
    "fix:unsafe": "biome check --fix --unsafe .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sevendays/config": "workspace:*",
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.1"
  },
  "peerDependencies": {
    "zod": "^4.5.1"
  }
}

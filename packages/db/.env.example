# packages/db/.env — gitignored; paste values, never commit them.
# Session-mode pooler URL (Supabase → Project Settings → Database → Connection pooling
# → Session mode, port 5432): used by drizzle-kit (db:generate/db:migrate/db:studio)
# AND by the seed/verify scripts. Session semantics keep drizzle-kit's advisory locks safe.
DATABASE_MIGRATE_URL=

# Pooled transaction-mode URL (port 6543) — fallback if the session URL is absent;
# both reach the same database. See docs/adr/0007-database-connection-topology.md.
DATABASE_URL=
{
  "name": "@sevendays/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "biome lint",
    "format": "biome format",
    "fix": "biome check --fix .",
    "fix:unsafe": "biome check --fix --unsafe .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@sevendays/config": "workspace:*",
    "@sevendays/types": "workspace:*",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}

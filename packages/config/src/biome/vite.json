{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "on"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "noNamespaceImport": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noHeadElement": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single"
    }
  }
}

# Database (Supabase) — two connection strings, see docs/adr/0007-database-connection-topology.md
# Pooled connection (Supavisor, port 6543): apps/api Worker runtime, wrangler dev (.dev.vars), seed script.
DATABASE_URL=
# Direct connection (port 5432): drizzle-kit generate/migrate/studio only.
DATABASE_MIGRATE_URL=

# Integration-test database (ADR-0008) — docker compose Postgres 17, static db sevendays_test.
# Local default: postgres://postgres:postgres@localhost:5432/sevendays_test (CI overrides via env).
TEST_DATABASE_URL=

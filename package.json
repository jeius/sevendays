{
  "name": "sevendays",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"{./packages/*}...\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "biome lint",
    "format": "turbo run format",
    "format:root": "biome format",
    "fix": "turbo run fix",
    "fix:unsafe": "turbo run fix:unsafe",
    "fix:root": "biome check --write",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint format typecheck test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@sevendays/config": "workspace:*",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
